    color: var(--on-dark-body);
    font-size: 1.0625rem;
  }

  .ar-what__title,
  .ar-gap__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    letter-spacing: -0.02em;
    margin-bottom: 1.25rem;
    max-width: 22ch;
  }
  .ar-what__body p,
  .ar-gap__body p {
    color: var(--body);
    line-height: 1.7;
    margin-bottom: 1.1rem;
  }
