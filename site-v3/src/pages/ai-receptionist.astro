    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ar-hero__rule {
    width: min(320px, 60%);
    margin-block: 1.5rem;
  }
