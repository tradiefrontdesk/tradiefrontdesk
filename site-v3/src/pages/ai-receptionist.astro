    margin-bottom: 0.85rem;
  }
  .ar-gap__links {
    margin-top: 1.5rem;
    max-width: 68ch;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }
  .ar-gap__links a {
    color: var(--ink);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--action);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .ar-split__head {
