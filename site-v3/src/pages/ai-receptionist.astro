  }
  /* Ratio kept unique to this page — 0.75/1.25, not used by any other hero
     split on the site. */
  .ar-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }
  .ar-hero__inner {
    max-width: 62ch;
  }
  @media (max-width: 880px) {
