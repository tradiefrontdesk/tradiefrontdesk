---
// /guides/ — the cluster hub.
//
// Its job is crawlability and orientation: one page that links to every guide
// so nothing in the set depends on the footer alone for discovery, and a
// reader who lands mid-cluster can see what else exists.
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Reveal from "@/components/motion/Reveal.astro";
import DraftPath from "@/components/motion/DraftPath.astro";
import CTASection from "@/components/CTASection.astro";
import BlueprintFigure from "@/components/shared/BlueprintFigure.astro";
import HomeVideo from "@/components/home/HomeVideo.astro";
import { corePromise } from "@/data/site";

const all = await getCollection("guides");
const pillar = all.find((g) => g.data.pillar);
const supporting = all
  .filter((g) => !g.data.pillar)
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="Guides for Trade Businesses"
  description="Plain-English guides on handling trade enquiries — what an answering service costs in NZ, how fast to reply, and how it plays out trade by trade."
>
  <section class="gi-hero band-dark blueprint-grid">
    {/* 2-col / 1-row split. Ratio deliberately unused elsewhere on the site,
        so this hero doesn't stamp out a row already used by another page
        type. Figure is drawn SVG, not a Remotion player: heroes are above
        the fold and a player costs ~439KB before first paint. */}
    <div class="container gi-hero__grid">
      <div class="gi-hero__inner">
        <p class="mono-label gi-hero__eyebrow">Guides</p>
        <Reveal as="h1" variant="draft" class="gi-hero__title">
          How trade businesses handle enquiries.
        </Reveal>
        <div class="gi-hero__rule" aria-hidden="true">
          <DraftPath viewBox="0 0 320 8" d="M2 4 L318 4" stroke="var(--action)" strokeWidth={2} />
        </div>
        <p class="gi-hero__lead max-measure">
          Straight answers on missed calls, quotes going quiet, what an answering
          service actually costs in New Zealand, and when the honest answer is
          that you do not need one. Plus how all of it looks from inside a
          specific trade, because a roofer's bad week and a builder's bad week
          are not the same week. Written to be useful whether or not you ever
          talk to us.
        </p>
      </div>

      <HomeVideo
        id="GuidesHubHeroClip"
        tone="dark"
        class="gi-hero__figure"
      />
    </div>
  </section>

  <section class="gi-list band-light section">
    <div class="container">
      {
        pillar && (
          <a class="gi-pillar surface-light" href={`/guides/${pillar.id}/`}>
            <p class="mono-label gi-pillar__tag">Start here</p>
            <h2 class="gi-pillar__title">{pillar.data.heading}</h2>
            <p class="gi-pillar__text">{pillar.data.lead}</p>
          </a>
        )
      }

      <ol class="gi-grid">
        {
          supporting.map((g, i) => (
            <Reveal as="li" variant="draft" delay={(i % 3) * 0.05} class="gi-card">
              <span class="mono-label gi-card__no">{String(i + 1).padStart(2, "0")}</span>
              <h3 class="gi-card__title">
                <a href={`/guides/${g.id}/`}>{g.data.heading}</a>
              </h3>
              <p class="gi-card__text">{g.data.lead}</p>
            </Reveal>
          ))
        }
      </ol>

      <HomeVideo
        id="GuidesHubVideo"
        tone="light"
        caption="Fig. — a guide's steps, becoming a checklist"
        class="gi-video"
      />
    </div>
  </section>

  <CTASection
    title="Rather we just looked at your setup?"
    text={`${corePromise} Book a free audit and we'll map where enquiries are slipping — no pressure, no lock-in.`}
  />
</BaseLayout>

<style>
  .gi-hero {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }
  /* Ratio deliberately unused elsewhere on the site (existing splits include
     1.15/0.85, 0.82/1.18, 1.2/0.8, 0.8/1.2, 1.25/0.75, 1.1/0.9, 0.95/1.05)
     so no two page types stamp out an identical row. */
  .gi-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr);
    gap: clamp(1.75rem, 4vw, 3.5rem);
    align-items: center;
  }
  .gi-hero__inner {
    max-width: 62ch;
  }
  @media (max-width: 880px) {
    .gi-hero__grid {
      grid-template-columns: 1fr;
    }
    /* Figure drops below the copy on small screens — the headline is what a
       reader came for, the drawing is support. */
    .gi-hero__figure {
      order: 2;
      max-width: 460px;
    }
  }
  .gi-hero__eyebrow {
    color: var(--marker);
    margin-bottom: 1.25rem;
  }
  .gi-hero__title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .gi-hero__rule {
    width: min(320px, 60%);
    margin-block: 1.5rem;
  }
  .gi-hero__lead {
    color: var(--on-dark-body);
    font-size: 1.0625rem;
  }

  .gi-pillar {
    display: block;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .gi-pillar:hover,
  .gi-pillar:focus-visible {
    border-color: var(--action);
  }
  /* 3.15:1 in --action on --surface-light; --muted clears 7.41:1. */
  .gi-pillar__tag {
    color: var(--muted);
    margin-bottom: 0.85rem;
  }
  .gi-pillar__title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
    color: var(--ink);
  }
  .gi-pillar__text {
    color: var(--muted);
    max-width: 68ch;
  }

  .gi-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 290px), 1fr));
    gap: 1px;
    background: var(--line-light);
    border: 1px solid var(--line-light);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .gi-card {
    background: var(--surface-light);
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .gi-card__no {
    color: var(--muted);
    display: block;
    margin-bottom: 0.75rem;
  }
  .gi-card__title {
    font-size: 1.0625rem;
    letter-spacing: -0.01em;
    margin-bottom: 0.5rem;
  }
  .gi-card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .gi-card__title a:hover,
  .gi-card__title a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--action);
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }
  .gi-card__text {
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* Below-fold video: deferred with client:visible inside HomeVideo/SectionVideo,
     so its ~439KB Remotion cost never touches first paint. Sits inside the
     existing light band, after the guide grid — no band change needed. */
  .gi-video {
    width: 100%;
    max-width: 420px;
    margin: clamp(2.5rem, 5vw, 3.5rem) auto 0;
  }
</style>
