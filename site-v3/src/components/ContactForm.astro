---
// PLACEHOLDER STATE — the fields are deliberately disabled.
//
// This form previously ran a submit handler that called preventDefault(),
// logged the payload to the console, showed a success message and then reset
// the form — so every enquiry was silently discarded while the visitor was
// told it had been sent. Disabling the fields is the honest interim state:
// nobody can type an enquiry into something that cannot deliver it.
//
// TO REPLACE: drop the GoHighLevel form embed in here, following the same
// pattern as AuditForm.astro (iframe + form_embed.js), then delete this
// whole placeholder block including the notice below.
---

<div class="form-panel surface-light">
  <p class="mono-label form-panel__notice-label">Form offline</p>
  <p class="form-panel__notice">
    Our enquiry form is being reconnected. In the meantime the fastest way to
    reach us is the phone number for your region, or email — both are listed
    beside this panel and go straight to a real person.
  </p>

  <fieldset class="form-panel__fieldset" disabled>
    <legend class="visually-hidden">Enquiry form (currently unavailable)</legend>
    <div class="form-panel__grid">
      <label class="form-field">
        <span class="mono-label form-field__label">Name</span>
        <input class="form-field__input" name="name" autocomplete="name" />
      </label>
      <label class="form-field">
        <span class="mono-label form-field__label">Business name</span>
        <input class="form-field__input" name="businessName" autocomplete="organization" />
      </label>
      <label class="form-field">
        <span class="mono-label form-field__label">Phone</span>
        <input class="form-field__input" name="phone" type="tel" autocomplete="tel" />
      </label>
      <label class="form-field">
        <span class="mono-label form-field__label">Email</span>
        <input class="form-field__input" name="email" type="email" autocomplete="email" />
      </label>
      <label class="form-field">
        <span class="mono-label form-field__label">Website</span>
        <input class="form-field__input" name="website" type="url" placeholder="https://" />
      </label>
      <label class="form-field">
        <span class="mono-label form-field__label">Trade/service</span>
        <input class="form-field__input" name="tradeService" />
      </label>
    </div>
    <label class="form-field form-field--full">
      <span class="mono-label form-field__label">Message</span>
      <textarea class="form-field__input" name="message"></textarea>
    </label>
    <button class="btn btn-primary form-panel__submit" type="submit">Send Enquiry</button>
  </fieldset>
</div>

<style>
  .form-panel {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.75rem, 4vw, 3rem);
  }

  .form-panel__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .form-field--full {
    grid-column: 1 / -1;
  }

  .form-field__label {
    color: var(--ink);
  }

  .form-field__input {
    width: 100%;
    padding: 0.85rem 1rem;
    border: 1.5px solid var(--line-light);
    border-radius: var(--radius-sm);
    background: var(--surface-light);
    color: var(--ink);
    font-size: 0.9375rem;
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .form-field__input::placeholder {
    color: var(--muted);
  }

  .form-field__input:hover {
    border-color: var(--muted);
  }

  .form-field__input:focus-visible {
    border-color: var(--action);
  }

  textarea.form-field__input {
    min-height: 120px;
    resize: vertical;
  }

  .form-panel__submit {
    align-self: flex-start;
  }

  /* The fieldset needs a legend for assistive tech, but the visible notice
     above already says the same thing — so the legend is hidden visually
     without being removed from the accessibility tree. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* Placeholder state — the notice carries the message, so it leads the panel
     rather than sitting under the fields as fineprint nobody reads. */
  /* --ink, not --action: at 3.15:1 the one label telling visitors the form
     does not work was the least legible text on the page. */
  .form-panel__notice-label {
    color: var(--ink);
  }

  .form-panel__notice {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--body);
    max-width: 60ch;
    margin-top: -1.25rem;
  }

  .form-panel__fieldset {
    /* Reset the UA fieldset box; it is a grouping device here, not a visual
       frame. min-width:0 stops the legacy fieldset min-content sizing bug
       from breaking the grid below. */
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .form-panel__fieldset:disabled {
    opacity: 0.55;
  }

  .form-panel__fieldset:disabled .form-field__input,
  .form-panel__fieldset:disabled .form-panel__submit {
    cursor: not-allowed;
  }

  @media (max-width: 640px) {
    .form-panel__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
