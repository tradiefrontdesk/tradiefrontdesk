---
// BaseLayout.astro
// Shared page shell: head/meta/SEO, skip link, Header, <main>, Footer,
// StickyMobileCTA. Fonts + global styles come in via global.css.
//
// Note on the OG image: the default is og-image.svg. SVG og:image does not
// render on most platforms (Facebook, X, LinkedIn); it is used anyway as
// the project default, and the `ogImage` prop exists so a PNG can be
// swapped in later without touching this layout.
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import StickyMobileCTA from "@/components/StickyMobileCTA.astro";
import { brand, contactDetails, legalDetails, corePromise, packages } from "@/data/site";
import "@/styles/global.css";

export type BreadcrumbCrumb = { name: string; href: string };

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Override the sticky mobile bar's CTA target (e.g. "#audit-form" on /free-audit). */
  stickyCtaHref?: string;
  /**
   * Ancestors of this page, excluding Home (added automatically) and excluding
   * the page itself (derived from `title`). A page one level below Home needs
   * nothing; a guide passes [{ name: "Guides", href: "/guides/" }].
   */
  breadcrumbs?: BreadcrumbCrumb[];
  /** Emits Service schema. Pass the service name for trade/problem/location pages. */
  serviceName?: string;
  /** Emits Article schema. Guides pass their dates. */
  article?: { published: Date; modified?: Date };
}

const {
  title,
  description,
  ogImage = "/og-image.png",
  stickyCtaHref,
  breadcrumbs = [],
  serviceName,
  article,
} = Astro.props;

const siteName = brand.name;
const fullTitle = `${title} | ${siteName}`;
const origin = Astro.site ?? Astro.url.origin;
const canonical = new URL(Astro.url.pathname, origin);
const ogImageUrl = new URL(ogImage, origin);

// "Organization", not "LocalBusiness". LocalBusiness describes a business with
// a physical location customers visit; this is a remote service delivered by
// phone and software across multiple countries, with no street address and no
// `address` property to give. Google's own Business Profile eligibility rules
// exclude businesses with no face-to-face customer contact, which is the same
// distinction. Claiming LocalBusiness without an address is a schema mismatch,
// not a shortcut to local visibility.
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: siteName,
  alternateName: brand.fullName,
  description: brand.trustLine,
  slogan: corePromise,
  url: origin.toString(),
  email: contactDetails.email,
  telephone: contactDetails.phones[0].value,
  areaServed: contactDetails.phones.map((phone) => ({
    "@type": "Country",
    name: phone.region,
  })),
  contactPoint: contactDetails.phones.map((phone) => ({
    "@type": "ContactPoint",
    telephone: phone.value,
    contactType: "sales",
    areaServed: phone.region,
  })),
  parentOrganization: legalDetails.providerEntities.map((name) => ({
    "@type": "Organization",
    name,
  })),
  // The published packages as a service catalog. Prices are the advertised
  // starting points and are marked as such — `priceCurrency` is NZD, confirmed
  // by the client, and every package price on the site reads "from", so the
  // Offer carries `minPrice` rather than a flat `price` it cannot honour.
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Managed front desk packages",
    itemListElement: packages.map((pkg) => ({
      "@type": "Offer",
      name: pkg.name,
      description: pkg.bestFor,
      priceSpecification: {
        "@type": "PriceSpecification",
        priceCurrency: "NZD",
        minPrice: Number(pkg.price.replace(/^From \$/, "").split(" ")[0].replace(/,/g, "")),
        // valueAddedTaxIncluded is deliberately omitted. GST treatment has not
        // been confirmed by the client, and asserting it in schema while
        // refusing to state it in copy would be the same claim by another route.
      },
      itemOffered: {
        "@type": "Service",
        name: pkg.name,
        serviceType: "Managed front desk for trade businesses",
      },
    })),
  },
};

// BreadcrumbList on every page. Home is always position 1 and the current page
// is always last, so callers only pass the levels in between.
const crumbs = [
  { name: "Home", href: "/" },
  ...breadcrumbs,
  { name: title, href: Astro.url.pathname },
];
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: new URL(c.href, origin).toString(),
  })),
};

// Service, on the pages that describe an actual service offering. `provider`
// points back at the Organization rather than restating it, so there is one
// entity on the page and not two competing ones.
const serviceLd = serviceName
  ? {
      "@context": "https://schema.org",
      "@type": "Service",
      name: serviceName,
      serviceType: "Managed front desk for trade businesses",
      description,
      url: canonical.toString(),
      provider: { "@type": "Organization", name: siteName, url: origin.toString() },
      areaServed: contactDetails.phones.map((phone) => ({
        "@type": "Country",
        name: phone.region,
      })),
    }
  : null;

// Article, on the guides. dateModified falls back to datePublished rather than
// being omitted, because a missing modified date is worse than an honest one.
const articleLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      datePublished: article.published.toISOString(),
      dateModified: (article.modified ?? article.published).toISOString(),
      mainEntityOfPage: { "@type": "WebPage", "@id": canonical.toString() },
      publisher: { "@type": "Organization", name: siteName, url: origin.toString() },
      image: ogImageUrl.toString(),
    }
  : null;

const structuredData = [jsonLd, breadcrumbLd, serviceLd, articleLd].filter(Boolean);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#0E2233" />
    <meta name="application-name" content={siteName} />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="mask-icon" href="/favicon.svg" color="#FF5A1F" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={`${siteName} — ${corePromise}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {
      structuredData.map((block) => (
        <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <StickyMobileCTA href={stickyCtaHref} />
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 100;
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-sm);
    background: var(--action);
    color: var(--on-action);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    transform: translateY(calc(-100% - 1.5rem));
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }
</style>
